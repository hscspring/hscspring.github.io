<% if (post.prev || post.next){ %>
<nav class="nav-single">
    <h3 class="assistive-text">文章导航</h3>
    <% if (post.prev){ %>
        <div class="nav-previous">
          <a href="<%- url_for(post.prev.path) %>" rel="prev">
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title"><% if (post.prev.title){ %><%= post.prev.title %><% } else { %>(no title)<% } %></span>
          </a>
        </div>
    <% } %>
    <% if (post.next){ %>
        <div class="nav-next">
          <a href="<%- url_for(post.next.path) %>" rel="next">
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title"><% if (post.next.title){ %><%= post.next.title %><% } else { %>(no title)<% } %></span>
          </a>
        </div>
    <% } %>
</nav><!-- .nav-single -->
<% } %>

