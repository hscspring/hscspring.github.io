<article id="<%= post.layout %>-<%= post.slug %>" class="<%= post.layout %>-<%= post.slug %> post type-post status-publish format-standard hentry">
      <header class="entry-header">
        <% if (post.link || post.title){ %>
        <%- partial('post/title', {class_name: 'article-title'}) %>
        <% } %>
      </header><!-- .entry-header -->

    <div class="entry-content">
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
        <% if (theme.excerpt_link){ %>
          <p class="article-more-link">
            <a href="<%- url_for(post.path) %>#more" class="more-link"><%= theme.excerpt_link %> <span class="meta-nav">→</span></a>
          </p>
        <% } %>
      <% } else { %>
        <%
        var articleHeadingCount = ((post.content || '').match(/<h[23](?:\s[^>]*)?>/g) || []).length;
        var showAutomaticToc = !index && (post.layout === 'post' || post.toc === true) && post.toc !== false && articleHeadingCount >= 5;
        %>
        <% if (showAutomaticToc){ %>
          <details id="toc" class="toc-article toc-article-collapsible">
            <summary>
              <span><%= post.layout === 'page' ? '页面目录' : '文章目录' %></span>
              <span class="toc-count"><%= articleHeadingCount %> 节</span>
            </summary>
            <div class="toc-article-content">
              <%- toc(post.content, {list_number:false, min_depth:2, max_depth:3}) %>
            </div>
          </details>
        <% } else if (post.toc == true){ %>
          <div id="toc" class="toc-article">
            <strong class="toc-title">目录</strong>
            <%- toc(post.content, {list_number:false}) %>
          </div>
        <% } %>
        <%- post.content %>
      <% } %>
    </div><!-- .entry-content -->

    <% if (!index && post.layout === 'post'){ %>
    <section class="article-share" data-share-url="<%- full_url_for(post.path) %>" data-share-title="<%= post.title || config.title %>">
      <button class="article-share-trigger" type="button" aria-expanded="false" aria-controls="article-share-panel">分享本文</button>
      <div id="article-share-panel" class="article-share-panel" hidden>
        <div class="article-share-actions">
          <button class="article-share-copy" type="button">复制链接</button>
          <a class="article-share-x" href="#" target="_blank" rel="noopener noreferrer">分享到 X</a>
          <button class="article-share-qr-toggle" type="button" aria-expanded="false">显示二维码</button>
        </div>
        <div class="article-share-qr" hidden>
          <div class="article-share-qr-code" aria-label="本文链接二维码"></div>
          <p>用手机扫码继续阅读</p>
          <button class="article-share-qr-save" type="button">保存 / 发送二维码</button>
        </div>
        <p class="article-share-status" role="status" aria-live="polite"></p>
      </div>
    </section>
    <% } %>

    <% if (post.layout === 'post'){ %>
      <footer class="entry-meta">
      <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
      <%- partial('post/category') %>
      <%- partial('post/tag') %>
      </footer>
    <% } %>
</article>

<% if (!index){ %>
    <%- partial('post/nav') %>
<% } %>

<%- partial('comment') %>
