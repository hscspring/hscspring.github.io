<div id="global-search-dialog" class="global-search-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="global-search-title">
  <div class="global-search-panel">
    <div class="global-search-header">
      <h2 id="global-search-title">搜索</h2>
      <button class="global-search-close" type="button" aria-label="关闭搜索">关闭</button>
    </div>
    <div class="local-search global-local-search" data-search-limit="12">
      <input
        class="local-search-input"
        type="search"
        placeholder="搜索文章 / 标签 / 内容"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="local-search-status" aria-live="polite">输入关键词开始搜索</div>
      <div class="local-search-results"></div>
    </div>
  </div>
</div>
