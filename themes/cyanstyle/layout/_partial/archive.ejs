<% if (is_archive()){ %>
  <header class="archive-page-header">
    <h1>文章存档<% if (is_month()){ %> · <%= page.year %>/<%= page.month %><% } else if (is_year()){ %> · <%= page.year %><% } %></h1>
    <p>沿时间回看写过的文章，也看看关注与思考如何一路变化。</p>
  </header>
<% } %>

<% if (pagination == 2){ %>
  <% page.posts.each(function(post){ %>
    <%- partial('article', {post: post, index: true}) %>
  <% }) %>
  <% if (page.total > 1){ %>
    <nav id="pagination">
      <nav id="page-nav">
        <%- paginator({
          prev_text: '&laquo; ' + theme.prev,
          next_text: theme.next + ' &raquo;'
        }) %>
      </nav>
    </nav>
  <% } %>
<% } else { %>
  <% var last; %>
  <% page.posts.each(function(post, i){ %>
    <% var year = post.date.year(); %>
    <% if (last != year){ %>
      <% if (last != null){ %>
        </div></section>
      <% } %>
      <% last = year; %>
      <section class="archives-wrap">
        <div class="archive-year-wrap">
          <a href="<%- url_for('archives/' + year) %>" class="archive-year"><%= year %></a>
        </div>
        <div class="archives">
    <% } %>
    <%- partial('archive-post', {post: post, even: i % 2 == 0}) %>
  <% }) %>
  <% if (page.posts.length){ %>
    </div></section>
  <% } %>
<% } %>
